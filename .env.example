# ==============================================================================
# AI-Powered Multi-Platform Prospect Discovery API - Environment Configuration
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=4000
ENVIRONMENT=development
DEBUG=false

# LLM Provider Configuration
# Supported options: "gemini", "openai", "claude", "groq", "heuristic"
# (If API key is omitted, the built-in heuristic NLP engine runs automatically with zero cost)
LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=heuristic

# Google Gemini Settings (Recommended - lowest cost & fastest response)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI Settings (Alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude Settings (Alternative)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Groq Settings (Optional)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Search Discovery Provider Settings (Optional)
# If left empty, the engine uses free, zero-config DuckDuckGo discovery automatically.
SERPER_API_KEY=
SERPAPI_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
TAVILY_API_KEY=
BING_SEARCH_API_KEY=

# Engine Limits & Optimization
MAX_PROSPECTS_PER_QUERY=15
SEARCH_RESULTS_PER_PLATFORM=6
HTTP_TIMEOUT_SECONDS=10.0
MAX_PARALLEL_SEARCHES=5
ENABLE_CACHE=true
CACHE_TTL_SECONDS=3600
